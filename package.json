{
  "name": "Caridade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "translate": "node scripts/translate.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:ontology": "node scripts/check-ontology.mjs",
    "smoke": "node scripts/dev/smoke.mjs",
    "verify": "bash scripts/dev/verify.sh",
    "test:rules": "firebase emulators:exec --only firestore --project demo-caridade \"node --test tests/rules/firestore.rules.test.mjs\"",
    "test:e2e": "firebase emulators:exec --only firestore --project demo-caridade \"node scripts/dev/e2e.mjs\""
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "next": "16.3.5",
    "next-intl": "^4.14.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "firebase": "^12.19.0",
    "postcss": "8.5.28",
    "tailwindcss": "^4.1.12",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "protobufjs": "7.6.6",
    "@protobufjs/utf8": "1.1.1",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
