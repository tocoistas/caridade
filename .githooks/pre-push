#!/bin/sh
# Bloqueia push directo para main — main só avança por merge de PR no GitHub.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "✋ Push directo para 'main' não é permitido. Abra uma PR (ver CONTRIBUTING.md)." >&2
    exit 1
  fi
done
exit 0
