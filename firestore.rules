rules_version = '2';

// Base Firestore nomeada `caridade` (projecto insjcm).
//
// Autenticação própria: TODO o acesso aos dados passa pelo servidor Next.js
// (/api/v1, Admin SDK com a service account do App Hosting — que não é afectado
// por estas regras). Browsers e a app Android NÃO têm acesso directo ao Firestore.
// A autorização vive em src/server/session.ts + src/lib/roles.ts (ver docs/auth.md).
//
// Testes: npm run test:rules.  Deploy: firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
